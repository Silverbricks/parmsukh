{
  "name": "parmsukh",
  "version": "3.0.0",
  "private": true,
  "description": "PARMSUKH Ayurveda & Homoeopathy Centre - patient, doctor & e-commerce platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
